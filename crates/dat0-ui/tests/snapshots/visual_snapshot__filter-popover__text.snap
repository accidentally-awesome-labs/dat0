<option value="5">↤ Ends with</option>
<option value="6">∈ In list</option>
<option value="7">⌗ Regex</option>
<option value="8">∅ Is empty</option>
<option value="9">◉ Is not empty</option>
</select>
<input class="d0-field" data-a11y-id="filter-value" aria-label="Value" type="text" value=""/>
<div class="d0-popover-actions">
<button class="d0-btn is-primary" data-a11y-id="filter-apply" role="button" aria-label="Apply" tabindex="0" disabled=true aria-disabled="true">Apply</button>
<button class="d0-btn is-ghost" data-a11y-id="filter-cancel" role="button" aria-label="Cancel" tabindex="0">Cancel</button>
<button class="d0-btn is-ghost" data-a11y-id="filter-clear" role="button" aria-label="Clear" tabindex="0">Clear</button>
</div>
</div>
