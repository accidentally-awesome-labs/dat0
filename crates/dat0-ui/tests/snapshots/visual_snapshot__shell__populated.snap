---
source: crates/dat0-ui/tests/visual_snapshot.rs
expression: "rendered[0].1"
---
<div class="d0-scene" data-scene="shell/populated" style="width: 1440px; height: 900px; overflow: hidden">
<div data-a11y-id="window" tabindex="0" class="d0-window">
<div class="d0-titlebar" data-a11y-id="titlebar" role="banner">
<div class="d0-traffic-spacer">
</div>
<div class="d0-wordmark no-drag">dat<span class="d0-logomark">
</span>
</div>
<span class="d0-mono" style="color: var(--d0-chrome-muted)">q3-review</span>
<div style="margin-left: auto">
</div>
<div class="d0-pill no-drag" data-a11y-id="source-pill">
<span class="d0-dot">
</span>
<span class="d0-label" style="color: var(--d0-warn-text)">local</span>
</div>
</div>
<div class="d0-tabstrip" data-a11y-id="tabstrip" role="tablist">
<div class="d0-search-slot" data-a11y-id="command-slot">
<button class="d0-search-gutter" data-a11y-id="command-launcher" role="button" aria-label="Open the command palette" tabindex="0">
<span>search tables, queries…</span>
<span class="d0-key">⌘K</span>
</button>
</div>
<button class="d0-tab is-active" data-a11y-id="tab-0" role="tab" aria-selected="true" tabindex="-1">
<span class="d0-swatch sw-csv">
</span>sales.csv</button>
<button class="d0-tab" data-a11y-id="tab-1" role="tab" aria-selected="false" tabindex="-1">
<span class="d0-swatch sw-parquet">
</span>trips.parquet</button>
<button class="d0-tab" data-a11y-id="tab-2" role="tab" aria-selected="false" tabindex="-1">revenue_by_region</button>
<div class="d0-tab-filler">
</div>
</div>
<div class="d0-shell" style="grid-template-columns: 238px 4px minmax(0, 1fr)">
<div class="d0-sidebar" data-a11y-id="sidebar" role="navigation" aria-label="Catalog">
<div class="d0-sidebar-head">
<span class="d0-label">catalog</span>
<span class="d0-mono is-local">local</span>
</div>
<div class="d0-sidebar-body" data-a11y-id="catalog-tree" role="tree" tabindex="0">
<div data-a11y-id="section-files" role="group" aria-label="FILES">
<button class="d0-section-label d0-label" data-a11y-id="section-toggle-files" aria-expanded="true">
<span class="d0-chevron">▾</span>FILES</button>
<button class="d0-row is-cursor" data-a11y-id="row-files-0" role="treeitem" aria-selected="true">
<span class="d0-row-name">
<span class="d0-swatch sw-csv">
</span>sales.csv</span>
<span class="d0-row-meta">
</span>
</button>
<button class="d0-row" data-a11y-id="row-files-1" role="treeitem" aria-selected="false">
<span class="d0-row-name">
<span class="d0-swatch sw-parquet">
</span>trips.parquet</span>
<span class="d0-row-meta">
</span>
</button>
<button class="d0-row" data-a11y-id="row-files-2" role="treeitem" aria-selected="false">
<span class="d0-row-name">
<span class="d0-swatch sw-other">
</span>revenue_by_region</span>
<span class="d0-row-meta">
</span>
</button>
</div>
