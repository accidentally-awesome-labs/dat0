<span class="d0-chevron">▾</span>CONNECTIONS</button>
<div class="d0-row is-empty" data-a11y-id="empty-connections">no connections</div>
</div>
<div data-a11y-id="section-packages" role="group" aria-label="PACKAGES">
<button class="d0-section-label d0-label" data-a11y-id="section-toggle-packages" aria-expanded="true">
<span class="d0-chevron">▾</span>PACKAGES</button>
<div class="d0-row is-empty" data-a11y-id="empty-packages">no packages</div>
</div>
</div>
<div class="d0-sidebar-foot">
<span>session · 1 window · 3 tabs</span>
<span>ai none</span>
<span class="is-ok">egress 0 B</span>
</div>
</div>
<div class="d0-splitter is-col" data-a11y-id="sidebar-splitter" role="separator" aria-orientation="vertical">
</div>
<div class="d0-workarea" style="grid-template-columns: minmax(0, 1fr) 0px">
<div class="d0-centre" style="grid-template-rows: minmax(0, 1fr) 0px">
