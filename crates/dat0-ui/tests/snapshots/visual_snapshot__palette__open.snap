---
source: crates/dat0-ui/tests/visual_snapshot.rs
expression: "rendered[0].1"
---
<div class="d0-scene" data-scene="palette/open" style="width: 1440px; height: 900px; overflow: hidden">
<div class="d0-scrim" data-a11y-id="palette-scrim">
<div class="d0-palette" data-a11y-id="palette" role="dialog" aria-modal="true" aria-label="Command Palette" tabindex="-1">
<div class="d0-palette-input">
<span class="d0-palette-prompt" aria-hidden="true">›</span>
<input class="d0-mono" data-a11y-id="palette-query" aria-label="Search commands" placeholder="Type a command…" value="" autofocus=true/>
<span class="d0-mono d0-hint" aria-hidden="true">esc</span>
</div>
<div class="d0-palette-list" data-a11y-id="palette-list">
<div class="d0-palette-canvas" style="height: 962px;">
<button class="d0-palette-row is-selected" data-a11y-id="palette-row-0" role="button" aria-label="AI Providers…" aria-selected="true" title="Settings" tabindex="-1" style="top: 0px;">
<span class="d0-palette-glyph" aria-hidden="true">⚙</span>
<span class="d0-palette-label">AI Providers…</span>
</button>
