# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# Cargo.lock is committed for binaries (dat0 is a binary application)

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Build artifacts (release packaging)
*.dmg
*.AppImage
*.zip

# Local environment
.env
.env.local
.env.*.local

# Secrets / signing (never commit)
*.pem
*.p12
*.cer
.sentry-cli.toml
ed25519_private.key

# Logs
*.log

# Test artifacts
/test-output/
**/__snapshots__/.tmp/

# Performance bench scratch
/criterion/
flamegraph.svg

# Python (for any auxiliary tooling)
__pycache__/
*.pyc
.venv/

# Node (for site repo if vendored locally)
node_modules/
.next/

# macOS notarization scratch
notarization-output.json

# Git worktrees (local development scratch)
.worktrees/

# P2: generated large fixtures live here; regenerated by dat0-fixtures crate
/tests/fixtures/large/

# Superpowers brainstorm transient state (visual companion mockups)
.superpowers/

# stray rustc snippet-spike output
rust_out

# Vendored JS build inputs (the built bundle in crates/dat0-ui/assets/ IS committed;
# node_modules is not — see crates/dat0-ui/vendor/codemirror/README.md).
node_modules/
